# ==========================================================================
# Project Intelligence Agent — environment configuration
# Copy this file to `.env` and fill in your local values.
#   cp .env.example .env
# Never commit real secrets.
# ==========================================================================

# --- Application ------------------------------------------------------------
# Port for the Express API.
API_PORT=4000
# Base URL of the API as seen by the browser (used by the Next.js frontend).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Comma-separated list of allowed CORS origins for the API.
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ----------------------------------------
# Local Docker Compose default (see docker-compose.yml).
DATABASE_URL=postgresql://pia:pia@localhost:5432/pia

# --- Redis (background jobs / BullMQ) -----------------------------------------
REDIS_URL=redis://localhost:6379

# --- LLM provider -------------------------------------------------------------
# The application is decoupled from any single LLM provider.
LLM_PROVIDER=opencode
# Model to use with the configured provider (configurable).
LLM_MODEL=deepseek-v4-flash
# TODO: OpenCode Go credentials. The exact variable names depend on the
# provider's documented integration format. Add them here once known, e.g.:
OPENCODE_API_KEY=

# --- LangSmith (tracing / observability / evaluation) --------------------------
# Tracing is OFF by default so the app runs without a LangSmith account.
LANGSMITH_TRACING=false
# TODO: uncomment and fill in to enable tracing.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=project-intelligence-agent

# --- GitHub integration (future) -----------------------------------------------
# TODO: fill in when GitHub sync is implemented.
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# Development-only GitHub token.
#
# Used to test the GitHub integration before the
# user/workspace connection flow is implemented.
#
# Do NOT commit a real token.
GITHUB_TOKEN=

# --- Jira integration (future) ---------------------------------------------------
# TODO: fill in when Jira sync is implemented.
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
