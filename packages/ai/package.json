    "langsmith": "^0.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@project-intelligence/eslint-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.3"
  }
}
