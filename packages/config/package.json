{
  "name": "@project-intelligence/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared configuration, environment loading and constants.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "zod": "^4.0.9"
  },
  "devDependencies": {
    "@project-intelligence/eslint-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.3"
  }
}
