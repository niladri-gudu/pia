{
  "name": "@project-intelligence/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, client and shared database access.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@project-intelligence/config": "workspace:*"
  },
  "devDependencies": {
    "@project-intelligence/eslint-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "prisma": "^6.19.3",
    "typescript": "^5.8.3"
  }
}
