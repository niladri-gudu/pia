{
  "name": "project-intelligence-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic RAG platform for software and project intelligence.",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@project-intelligence/web",
    "dev:api": "turbo run dev --filter=@project-intelligence/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @project-intelligence/database db:generate",
    "db:migrate": "pnpm --filter @project-intelligence/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @project-intelligence/database db:migrate:deploy",
    "db:push": "pnpm --filter @project-intelligence/database db:push",
    "db:studio": "pnpm --filter @project-intelligence/database db:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:down:clean": "docker compose down -v",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  }
}
